{
    "name": "phpmystic/liqx",
    "description": "A JSX-style template engine for PHP with compiled rendering, components, schema validation, and restricted JavaScript-style expressions.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Phpmystic\\Liqx\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phpmystic\\Liqx\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "@php tools/lint.php",
        "analyse": "phpstan analyse"
    },
    "keywords": [
        "template",
        "templating",
        "jsx",
        "liquid",
        "compiler"
    ],
    "homepage": "https://github.com/mehdilight/liqx",
    "support": {
        "issues": "https://github.com/mehdilight/liqx/issues",
        "source": "https://github.com/mehdilight/liqx",
        "docs": "https://github.com/mehdilight/liqx/tree/main/docs/syntax"
    }
}
